# Copy to `backend/.env` and adjust.
#
# ── Local (runserver on your machine, Postgres on localhost) ───────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DEBUG=True adds hostnames with ports (e.g. localhost:5173) for the Vite dev proxy.

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

DB_NAME=raffaello
DB_USER=postgres
DB_PASSWORD=test
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Production (Docker Compose on server; DB_HOST must be `db`) ─────────────
# SECRET_KEY=<generate-a-new-long-random-string>
# DEBUG=False
# ALLOWED_HOSTS=raffaello.se,www.raffaello.se
# CORS_ALLOWED_ORIGINS=https://raffaello.se,https://www.raffaello.se
# CSRF_TRUSTED_ORIGINS=https://raffaello.se,https://www.raffaello.se
#
# DB_NAME=raffaello
# DB_USER=raffaello_user
# DB_PASSWORD=<same-as-POSTGRES_PASSWORD in root .env.db>
# DB_HOST=db
# DB_PORT=5432
#
# After HTTPS works end-to-end, enable HSTS (seconds; e.g. one year):
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False

# ── Bokningar → Telegram (@BodenRaffaello_bot), one-way to you only ─────────
# Guests are NOT contacted. You only receive reservation details.
#
# 1) Open the bot on your phone and tap Start: https://t.me/BodenRaffaello_bot
# 2) Find chat id:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    → look for "chat":{"id": 123456789
# 3) Set values below (do not commit real secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Bokningar → Email (Resend), one-way to restaurant inbox ─────────────────
# Guests are NOT emailed. Restaurant staff receive reservation details.
#
# 1) Create an API key at https://resend.com
# 2) Verify a sending domain (or use Resend’s test sender while developing)
# 3) Set BOOKING_NOTIFY_EMAIL to the inbox that should get booking alerts
# 4) Set EMAIL_FROM to a verified sender, e.g. Raffaello <bokningar@your-domain.com>
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
EMAIL_FROM=
# Optional label shown in the email body (not a secret):
# BOOKING_RESTAURANT_NAME=Raffaello Restaurang, Drottninggatan 18, 961 35 Boden

# ── Lunch sync from Mat och Mat (optional overrides) ───────────────────────
# MATOCHMAT_LUNCH_URL=https://www.matochmat.se/lunch/boden/raffaello-stekhus-bar/
# MATOCHMAT_RESTAURANT_SLUG=raffaello-stekhus-bar
